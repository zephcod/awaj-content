# ── Meta Graph API ─────────────────────────────────────────────
# RECOMMENDED (multi-page): a never-expiring system-user token from
# Business Manager (Business settings → Users → System users →
# Generate token with pages_show_list, pages_manage_posts,
# pages_read_engagement), plus the page ids to manage.
FB_SYSTEM_USER_TOKEN=
FB_PAGE_IDS=pageid1,pageid2

# LEGACY (single page): a Page ID + Page access token. Used only when
# FB_SYSTEM_USER_TOKEN is not set.
# FB_PAGE_ID=
# FB_PAGE_ACCESS_TOKEN=

# Optional — Graph API version (default v23.0)
# FB_GRAPH_VERSION=v23.0

# ── Instagram scheduling queue (Appwrite) ──────────────────────
# Required only for SCHEDULED Instagram posts (immediate IG publishing
# works without it). Same Appwrite instance as the leadgen app is fine.
# After filling these, run once:  node scripts/setup-ig-db.mjs
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# Optional — protects /api/cron/ig and /api/cron/li on public deploys
# CRON_SECRET=

# ── LinkedIn (Community Management API) — SCAFFOLD ─────────────
# Unlike Meta, there's no system-user token: each connected LinkedIn
# organization's OAuth tokens are stored in Appwrite after its own Page
# super-admin completes consent at /api/linkedin/connect. Requires an
# approved LinkedIn Developer app (Community Management API product) —
# see README's LinkedIn section before relying on this.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the LinkedIn app,
# e.g. https://your-deploy.example.com/api/linkedin/callback
LINKEDIN_REDIRECT_URI=
# Optional — LinkedIn's REST API version (YYYYMM). Default: 202506.
# LINKEDIN_API_VERSION=202506
# Required for LinkedIn media/scheduling — run scripts/setup-li-db.mjs
# once it prints this id (no pre-existing bucket to reuse, unlike ig_media).
LI_MEDIA_BUCKET_ID=

# ── App auth (shared password, same scheme as awaj-leads) ──────
# Any long random string; rotating it logs everyone out
AUTH_SECRET=
# The password your team types on /login
APP_PASSWORD=
